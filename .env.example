# ChronoScholar — Environment Variables
# Copy this file to .env and fill in real values
# Never commit .env to version control

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: groq | gemini | ollama | fallback
LLM_PROVIDER=groq

# LLM Model names
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash

# ─── API Keys ─────────────────────────────────────────────────────────────────
# Get Groq key free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get Gemini key free at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama base URL (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Cognee ───────────────────────────────────────────────────────────────────
COGNEE_DB_PATH=./data/cognee.db
COGNEE_VECTOR_DB_PATH=./data/vectors

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///./mlflow_tracking/mlflow.db

# ─── FastAPI ──────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── arXiv ────────────────────────────────────────────────────────────────────
# Minimum seconds between requests — arXiv ToS requires >= 3.0
ARXIV_REQUEST_DELAY=3.0

# ─── Contradiction Detection ──────────────────────────────────────────────────
# Pairs below this threshold are excluded from the dashboard by default
CONTRADICTION_CONFIDENCE_THRESHOLD=0.7

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Papers per cognify() batch — lower = slower but more stable
COGNEE_BATCH_SIZE=15
