# ChronoScholar — Environment Variables
# Copy this file to .env and fill in real values
# Never commit .env to version control

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# APP_LLM_PROVIDER: controls ChronoScholar's own LLM client (groq | gemini | ollama | fallback)
APP_LLM_PROVIDER=groq
# LLM_PROVIDER: read by Cognee internally — must be a valid Cognee LLMProvider value
# Use "custom" to route any LiteLLM-format model string (e.g. groq/…, together/…)
LLM_PROVIDER=custom

# LLM Model names (ChronoScholar's own LLMService)
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash

# ─── LLM Architecture ───────────────────────────────────────────────────────
# ChronoScholar uses three LLM providers with distinct roles:
#
# 1. APP_LLM_PROVIDER (Gemini 2.5 Flash)
#    Used by: ContradictionService.detect(), query grounding
#    Why: High accuracy on scientific NLI, 1M TPM free tier
#
# 2. LLM_MODEL (GPT-4o-mini via OpenAI)
#    Used by: Cognee internal entity extraction + GRAPH_COMPLETION
#    Why: Reliable structured output, sufficient context window
#
# 3. GROQ_API_KEY (llama-3.1-8b-instant)
#    Used by: Tier-2 fallback when Gemini is unavailable
#    Why: Low latency, free tier for resilience
#
# This separation eliminates TPM contention between application
# LLM calls and Cognee's internal synthesis calls.

# ─── API Keys ─────────────────────────────────────────────────────────────────
# Get Groq key free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get Gemini key free at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama base URL (only needed if APP_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Cognee ───────────────────────────────────────────────────────────────────
COGNEE_DB_PATH=./data/cognee.db
COGNEE_VECTOR_DB_PATH=./data/vectors
# Set to "true" to skip Cognee's LLM/embedding connectivity check on startup
COGNEE_SKIP_CONNECTION_TEST=true
# CRITICAL — must be false for single-user deployments.
# Default true causes cognify() to write to a UUID-scoped
# LadybugDB file while get_graph_data() reads the global file.
# Result: empty graph, no error, silent failure.
ENABLE_BACKEND_ACCESS_CONTROL=false

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Provider for vector embeddings used by Cognee
# Options: openai | huggingface | ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Get OpenAI key at: https://platform.openai.com/api-keys
EMBEDDING_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── LLM (Cognee-internal, uses LLM_PROVIDER=custom + LiteLLM routing) ───────
# Format: provider/model-name as expected by Cognee's LiteLLM backend
# Cognee internal LLM — entity extraction + GRAPH_COMPLETION
# Must use LiteLLM provider prefix format (provider/model-name)
# Benchmark was run with openai/gpt-4o-mini — use this for
# reproducible results. Do not use groq/ here — Groq is
# assigned to GROQ_API_KEY as the application fallback tier.
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///./mlflow_tracking/mlflow.db

# ─── FastAPI ──────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── arXiv ────────────────────────────────────────────────────────────────────
# Minimum seconds between requests — arXiv ToS requires >= 3.0
ARXIV_REQUEST_DELAY=3.0

# ─── Contradiction Detection ──────────────────────────────────────────────────
# Pairs below this threshold are excluded from the dashboard by default
CONTRADICTION_CONFIDENCE_THRESHOLD=0.7

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Papers per cognify() batch — lower = slower but more stable
COGNEE_BATCH_SIZE=15

# ─── LLM Retry Backoff ────────────────────────────────────────────────────────
# Reduce retry backoff delays for demo/development (never use in production)
LLM_FAST_MODE=false
